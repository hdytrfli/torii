# host paths
WATCH_HOST=/mnt/atlas/downloads
LIBRARY_HOST=/mnt/atlas/media

# app
APP_TOKEN=
LOG_LEVEL=INFO

# defaults seeded into SQLite on first start
MIN_SIZE_MB=100
EXTENSIONS=mkv,mp4,avi,mov,m4v,webm,ts,m2ts
MOVIE_TEMPLATE={folder}/{folder}
TV_TEMPLATE={folder}/Season {season:02d}/{title} - {episode_tag}
ACTION=move
DELETE_SOURCE=false
CLEANUP_EMPTY_DIRS=true
AUTO_APPLY=false
AUTO_APPLY_CONFIDENCE=0.85
POLL_INTERVAL=60
STABLE_SECONDS=120
DRY_RUN=false

# optional metadata provider
JELLYFIN_URL=
JELLYFIN_API_KEY=

# optional LLM fallback
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# optional post actions
NOTIFY_URL=
POST_ACTION_CMD=
